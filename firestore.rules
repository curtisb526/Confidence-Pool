rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // EDIT: the three players' Gmail addresses
    function ok() { return request.auth != null && request.auth.token.email in ['you@gmail.com','friend1@gmail.com','friend2@gmail.com']; }
    function kick(gid) { return get(/databases/$(database)/documents/games/$(gid)).data.kickoff; }
    match /games/{g} { allow read: if ok(); }
    match /users/{u} { allow read: if ok(); allow write: if ok() && request.auth.uid == u; }
    match /picks/{id} {
      allow read: if ok();
      allow create, update: if ok()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.gameId + '_' + request.auth.uid
        && request.resource.data.pts in [1,3,5]
        && request.resource.data.side in ['home','away']
        && kick(request.resource.data.gameId) > request.time;   // server-side lock
      allow delete: if ok() && resource.data.uid == request.auth.uid && kick(resource.data.gameId) > request.time;
    }
  }
}
